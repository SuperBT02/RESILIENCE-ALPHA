# WAF Nginx + ModSecurity (OWASP CRS) — single public entry point (port 8080 -> 80).
# Routes to auth, payment and the frontend. The blocklist is updated by the
# remediation engine (shared volume) and reloaded on demand.

include /shared/blocklist.conf;

limit_req_zone $binary_remote_addr zone=login:10m rate=5r/s;
limit_req_zone $binary_remote_addr zone=pay:10m rate=20r/s;

server {
    listen 8080;
    server_name _;
    real_ip_header X-Forwarded-For;

    # Internal admin endpoint: reload after the blocklist is updated.
    location = /_admin/reload {
        allow 172.16.0.0/12;
        deny all;
        return 204;
    }

    location /auth/ {
        limit_req zone=login burst=10 nodelay;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_pass ${BACKEND_AUTH}/;
    }

    location /api/ {
        limit_req zone=pay burst=40 nodelay;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_pass ${BACKEND_PAYMENT}/api/;
    }

    location / {
        proxy_pass ${BACKEND_FRONT}/;
    }
}
